{
    "version": "0.2.0",
    "configurations": [
        // ========================================
        // 🚀 API
        // ========================================
        {
            "name": "🚀 Debug Active API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-active-api",
            "program": "${workspaceFolder}/src/${config:active.api}/bin/Debug/net8.0/${config:active.api}.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/${config:active.api}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": true,
            "suppressJITOptimizations": true,
            "symbolOptions": {
                "searchPaths": [],
                "moduleFilter": {
                    "mode": "loadAllButExcluded",
                    "excludedModules": [
                        "FluentValidation.dll",
                        "Microsoft.*",
                        "System.*"
                    ]
                }
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            }
        },
        // ========================================
        // 🧪 TESTS
        // ========================================
        {
            "name": "🧪 Debug Active Tests",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-active-tests",
            "program": "dotnet",
            "args": [
                "exec",
                "${config:dotnet.vstestPath}",
                "${workspaceFolder}/tests/${config:active.test}/bin/Debug/net8.0/${config:active.test}.dll",
                "/InIsolation",
                "/Logger:console;verbosity=detailed"
            ],
            "cwd": "${workspaceFolder}/tests/${config:active.test}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "justMyCode": true,
            "suppressJITOptimizations": true,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Testing"
            }
        }
    ]
}