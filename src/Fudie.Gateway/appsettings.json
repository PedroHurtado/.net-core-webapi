{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/users/{**catch-all}"
        }
      },
      "tenant-roles-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/tenant-roles/{**catch-all}"
        }
      },
      "memberships-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/memberships/{**catch-all}"
        }
      },
      "external-apps-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/external-apps/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auth-service:8080"
          }
        }
      }
    }
  }
}
