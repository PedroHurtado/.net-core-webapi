{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Fudie": {
    "ServiceId": "customer-service",
    "ServiceName": "Customer Service"
  },
  "Firestore": {
    "ProjectId": "demo-project",
    "EmulatorHost": "127.0.0.1:8080",
    "CredentialsPath": null,
    "DatabaseId": "(default)",
    "Pipeline": {
      "QueryLogLevel": "Count",
      "EnableAstLogging": false,
      "EnableCaching": true,
      "MaxRetries": 3,
      "RetryInitialDelayMs": 100
    }
  }
}