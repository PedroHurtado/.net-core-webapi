{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Fudie": {
    "ServiceId": "subscription-service",
    "ServiceName": "Subscription Service",
    "Security": {
      "JwksUrl": "http://localhost:5176/auth/jwks",
      "CacheRefreshMinutes": 60
    },
    "OpenApi": {
      "RequestPath": "subscriptions/OpenApi",
      "RoutePrefix": "subscriptions/swagger"
    }
  },
  "Firestore": {
    "ProjectId": "demo-project",
    "EmulatorHost": "127.0.0.1:8080",
    "CredentialsPath": null,
    "DatabaseId": "(default)",
    "Pipeline": {
      "QueryLogLevel": "Count",
      "EnableAstLogging": false,
      "EnableCaching": true,
      "MaxRetries": 3,
      "RetryInitialDelayMs": 100
    }
  }
}
