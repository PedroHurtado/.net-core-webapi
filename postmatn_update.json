              "pm.test(\"Response tiene estructura Problem Details\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('type');",
              "    pm.expect(response).to.have.property('title');",
              "    pm.expect(response).to.have.property('status', 404);",
              "    pm.expect(response).to.have.property('detail');",
              "    pm.expect(response).to.have.property('instance');",
              "});",
              "",
              "pm.test(\"Response contiene extensions\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('extensions');",
              "    pm.expect(response.extensions).to.have.property('traceId');",
              "    pm.expect(response.extensions).to.have.property('timestamp');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
