{
  "info": {
    "name": "Update Pizza Tests",
    "_postman_id": "update-pizza-tests",
    "description": "Tests de integración para el endpoint de actualización de pizzas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup - Create Test Pizza",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Pizza creada exitosamente\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const response = pm.response.json();",
              "pm.collectionVariables.set(\"testPizzaId\", response.id);",
              "pm.collectionVariables.set(\"testPizzaName\", response.name);",
              "pm.collectionVariables.set(\"testPizzaDescription\", response.description);",
              "pm.collectionVariables.set(\"testPizzaUrl\", response.url);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pizza Original Test\",\n  \"description\": \"Descripción original para testing\",\n  \"url\": \"https://original.com/pizza.jpg\",\n  \"ingredients\": []\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pizzas",
          "host": ["{{baseUrl}}"],
          "path": ["pizzas"]
        }
      }
    },
    {
      "name": "Setup - Create Test Ingredient",
