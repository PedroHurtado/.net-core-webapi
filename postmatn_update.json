    {
      "name": "Update Pizza - Valid Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response tiene la estructura correcta\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('id');",
              "    pm.expect(response).to.have.property('name');",
              "    pm.expect(response).to.have.property('description');",
              "    pm.expect(response).to.have.property('url');",
              "    pm.expect(response).to.have.property('price');",
              "    pm.expect(response).to.have.property('ingredients');",
              "});",
              "",
              "pm.test(\"Los datos se actualizaron correctamente\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.id).to.eql(pm.collectionVariables.get('testPizzaId'));",
              "    pm.expect(response.name).to.eql('Pizza Actualizada');",
              "    pm.expect(response.description).to.eql('Nueva descripción actualizada');",
              "    pm.expect(response.url).to.eql('https://nueva.com/pizza.jpg');",
              "});",
              "",
              "pm.test(\"Price es un número positivo\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.price).to.be.a('number');",
              "    pm.expect(response.price).to.be.at.least(0);",
              "});",
              "",
              "pm.test(\"Ingredients es un array\", function () {",
              "    const response = pm.response.json();",
              "    pm.expect(response.ingredients).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Pizza Actualizada\",\n  \"description\": \"Nueva descripción actualizada\",\n  \"url\": \"https://nueva.com/pizza.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pizzas/{{testPizzaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pizzas", "{{testPizzaId}}"]
        }
      }
    },
